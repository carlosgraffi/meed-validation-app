// MEED+ Track A validation app schema.
// Hews to Section 4 of the spec. Adds MagicToken for admin-distributed magic links
// (we are not using NextAuth's email-provider adapter — Carlos sends emails manually).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expert {
  id                   String       @id // matches experts.json expertId
  email                String       @unique
  fullName             String
  sectorSpecialization String?
  preferredCityIds     String?      // comma-separated, set during intake
  consentedAt          DateTime?
  completedAt          DateTime?
  assignments          Assignment[]
  evaluations          Evaluation[]
  magicTokens          MagicToken[]
}

model Assignment {
  id         String   @id @default(cuid())
  expertId   String
  cityId     String
  assignedAt DateTime @default(now())
  expert     Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([expertId, cityId])
}

model Evaluation {
  id             String       @id @default(cuid())
  expertId       String
  cityId         String
  startedAt      DateTime     @default(now())
  submittedAt    DateTime?
  timeOnTaskSec  Int?
  // Paginated flow. The two "reveal" sub-stages — where the expert finally
  // sees the model's rank order + LLM rationale and rates overall agreement
  // — sit AFTER the blind reorder, so P@3, P@10 and Spearman ρ are all
  // collected before any rationale exposure:
  //   stage1     — top-3 set membership (blind)
  //   stage2     — top-10 set membership (blind)
  //   sectionC   — missing actions (blind)
  //   stage3     — reorder top 5 (last blind stage; rank visible but no rationale)
  //   reveal1    — top-3 order + explanations, rate ranking agreement
  //   reveal2    — top-10 order + explanations, rate ranking agreement
  //   sectionE   — city comment
  //   complete
  // Each stage becomes read-only once advanced past.
  currentStage   String       @default("stage1")
  missingActions String?      // JSON array of strings, max 3
  cityComment    String?
  // Overall agreement Likert (1–5) the expert submits during the reveal
  // stages, after seeing the model's rank order + explanations for the
  // top-3 (top3Agreement) and top-10 (top10Agreement) respectively.
  // Nullable until the corresponding reveal stage has been completed.
  top3Agreement  Int?
  top10Agreement Int?
  expert         Expert       @relation(fields: [expertId], references: [id], onDelete: Cascade)
  ratings        Rating[]
  reorderTop5    ReorderTop5?

  @@unique([expertId, cityId])
}

model Rating {
  id           String     @id @default(cuid())
  evaluationId String
  actionId     String
  modelRank    Int        // 1–10, snapshotted at rating time
  // 'top3' (Stage 1) or 'top10' (Stage 2). Top-3 actions get two rows — one per
  // question — because symmetric questioning prevents Precision@10 bias from
  // "this is top-3-worthy" judgments leaking into "is this top-10-worthy?".
  question     String
  likert       Int        // 1–5
  notSure      Boolean    @default(false)
  ratedAt      DateTime   @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, actionId, question])
}

model ReorderTop5 {
  id               String     @id @default(cuid())
  evaluationId     String     @unique
  orderedActionIds String     // JSON array of 5 actionIds in expert's order
  evaluation       Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

// One-shot magic link tokens. Admin generates these in the dashboard and pastes them into
// emails sent from Carlos's account. Tokens are single-use and expire after MAGIC_LINK_TTL_MIN.
model MagicToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expertId  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  expert    Expert    @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
}
